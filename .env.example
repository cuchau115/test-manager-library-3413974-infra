# Configuracion del entorno de docker compose (Manager Library · infra).
# Copia este archivo a `.env` y rellena placeholders si hace falta.
# `.env` NO se versiona; solo `.env.example`.

# Motor PostgreSQL 16 (arranca VACIO: el DDL vive en las migraciones de la API).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_DB=library

# Puerto en el que se publica PostgreSQL en el host.
DB_PORT=5432

# --- Servicio api ---
# Puerto en el que se publica la API en el host.
API_PORT=8000
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
# Genera una con: docker compose run --rm api php artisan key:generate --show
APP_KEY=
# Clave de firma de los JWT (HS256). Cadena larga y aleatoria.
JWT_SECRET=changeme-jwt-secret
# Administrador inicial (se crea al arrancar).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme-admin
# Origen permitido por CORS (el frontend React en dev).
CORS_ORIGIN=http://localhost:5173

# --- Frontend React y sitio público ---
APP_PORT=5173
PAGE_PORT=8080
